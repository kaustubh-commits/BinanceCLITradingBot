# Binance Futures Trading Bot — Configuration
#
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# Binance API Credentials
# Generate these from your Binance account: API Management → Create API Key
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Set to True to use Binance Testnet (https://testnet.binancefuture.com/)
# Always test on testnet before live trading.
BINANCE_TESTNET=True